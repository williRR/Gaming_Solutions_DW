{
  "name": "gaming-solutions-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Panel administrativo para inventario y ventas de Gaming Solutions",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js && node --check src/middleware/auth.js && node --check src/supabase-api.js",
    "docker:smoke": "node scripts/smoke.js",
    "docker:env": "node scripts/gen-env.js --write",
    "docker:reset": "docker compose --env-file .env.docker down -v && node scripts/gen-env.js --write --force"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "^2.117.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "oracledb": "^6.7.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
